{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoJPDict",
  "version": "0.1.0",
  "identifier": "io.github.snoring71.neojpdict",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NeoJPDict",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: njmedia: http://njmedia.localhost; media-src 'self' njmedia: http://njmedia.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "Japanese dictionary reader",
    "longDescription": "Read EPWING and Yomitan dictionaries with vertical text.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
